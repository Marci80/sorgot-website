---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="הצטרפות — תערוכת הסריגה השנתית">

  <section class="px-4 py-20 max-w-xl mx-auto" dir="rtl" lang="he">

    <img
      src={`${import.meta.env.BASE_URL}images/Register hedline.png`}
      alt="הצטרפות"
      class="mb-6 w-full max-w-xs"
    />

    <p id="register-intro" class="text-lg sm:text-xl text-gray-700 leading-relaxed mb-10 text-right">
      אם את סורגת באהבה ורוצה להצטרף ולסרוג יחד איתנו, כתבי לנו ואנחנו ניצור קשר
    </p>

    <!--
      FORMSPREE SETUP (one-time):
      1. Go to https://formspree.io and sign up / log in.
      2. Click "New Form", name it "הרשמה לתערוכת סורגות", set the email to sorgotburgata@gmail.com.
      3. Copy the form ID (looks like "xpwrabcd") from the endpoint URL.
      4. Replace REPLACE_WITH_FORM_ID below with that ID, e.g. action="https://formspree.io/f/xpwrabcd"
    -->
    <form
      id="register-form"
      action="https://formspree.io/f/xvzjgyvl"
      method="POST"
      class="space-y-6"
    >
      <!-- Hidden fields for Formspree -->
      <input type="hidden" name="_subject" value="הרשמה חדשה לתערוכת סורגות" />
      <input type="hidden" name="_language" value="he" />
      <input type="hidden" name="_next" value="https://marci80.github.io/sorgot-website/thank-you" />

      <!-- שם מלא -->
      <div class="flex flex-col gap-1.5">
        <label for="name" class="text-sm font-medium text-gray-700">שם מלא <span class="text-burgundy" aria-hidden="true">*</span></label>
        <input
          type="text"
          id="name"
          name="name"
          placeholder="שם מלא"
          required
          class="w-full border border-gray-300 rounded-xl px-4 py-3 text-right text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-burgundy focus:border-transparent transition"
        />
      </div>

      <!-- מספר טלפון -->
      <div class="flex flex-col gap-1.5">
        <label for="phone" class="text-sm font-medium text-gray-700">מספר טלפון <span class="text-burgundy" aria-hidden="true">*</span></label>
        <input
          type="tel"
          id="phone"
          name="phone"
          placeholder="050-0000000"
          dir="ltr"
          required
          class="w-full border border-gray-300 rounded-xl px-4 py-3 text-right text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-burgundy focus:border-transparent transition"
        />
      </div>

      <!-- כתובת מייל -->
      <div class="flex flex-col gap-1.5">
        <label for="email" class="text-sm font-medium text-gray-700">כתובת מייל <span class="text-burgundy" aria-hidden="true">*</span></label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="example@email.com"
          dir="ltr"
          required
          class="w-full border border-gray-300 rounded-xl px-4 py-3 text-right text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-burgundy focus:border-transparent transition"
        />
      </div>

      <!-- יישוב -->
      <div class="flex flex-col gap-1.5">
        <label for="city" class="text-sm font-medium text-gray-700">יישוב</label>
        <input
          type="text"
          id="city"
          name="city"
          placeholder="שם הישוב"
          class="w-full border border-gray-300 rounded-xl px-4 py-3 text-right text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-burgundy focus:border-transparent transition"
        />
      </div>

      <!-- הערות -->
      <div class="flex flex-col gap-1.5">
        <label for="notes" class="text-sm font-medium text-gray-700">הערות</label>
        <textarea
          id="notes"
          name="notes"
          rows="5"
          placeholder="ספרי לנו קצת על עצמך..."
          class="w-full border border-gray-300 rounded-xl px-4 py-3 text-right text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-burgundy focus:border-transparent transition resize-none"
        ></textarea>
      </div>

      <p class="text-sm text-gray-500 text-right">שדות המסומנים ב-<span class="text-burgundy">*</span> הם שדות חובה</p>

      <!-- Submit -->
      <div class="pt-2">
        <button
          type="submit"
          id="register-submit"
          class="w-full sm:w-auto bg-burgundy hover:bg-burgundy-dark text-white text-lg font-bold px-14 py-4 rounded-full transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-burgundy"
        >
          הצטרפות
        </button>
      </div>

      <p
        id="register-error"
        role="alert"
        tabindex="-1"
        hidden
        class="text-right text-base font-medium text-burgundy-dark border border-burgundy/40 rounded-xl px-4 py-3 focus:outline-none"
      >
        היתה בעיה בשליחה, אפשר ללחוץ שוב על כפתור "הצטרפות" כדי שהפרטים יישלחו.
      </p>

    </form>

    <!-- In-page thank-you message, revealed after a successful send -->
    <div
      id="register-success"
      role="status"
      tabindex="-1"
      hidden
      class="text-center py-10 focus:outline-none"
    >
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6 leading-tight">
        תודה שנרשמת! 🧶
      </h2>
      <p class="text-lg sm:text-xl text-gray-700 leading-relaxed mb-10">
        קיבלנו את הפרטים שלך. אנחנו מתחילות לעבוד אחרי סיום ופירוק התערוכה הקיימת, וניצור קשר אחרי החגים.
      </p>
      <a
        href={base}
        class="inline-block bg-burgundy hover:bg-burgundy-dark text-white text-lg font-bold px-10 py-4 rounded-full transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-burgundy"
      >
        חזרה לדף הבית
      </a>
    </div>

    <!--
      NETLIFY FORMS VERSION (uncomment if migrating to Netlify):

      <form
        name="registration"
        method="POST"
        data-netlify="true"
        class="space-y-6"
      >
        <input type="hidden" name="form-name" value="registration" />
        <input type="hidden" name="_subject" value="הרשמה חדשה לתערוכת סורגות" />

        <div class="flex flex-col gap-1.5">
          <label for="name" class="text-sm font-medium text-gray-700">שם מלא</label>
          <input type="text" id="name" name="name" placeholder="שם מלא"
            class="w-full border border-gray-300 rounded-xl px-4 py-3 text-right text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-burgundy focus:border-transparent transition" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="phone" class="text-sm font-medium text-gray-700">מספר טלפון</label>
          <input type="tel" id="phone" name="phone" placeholder="050-0000000" dir="ltr"
            class="w-full border border-gray-300 rounded-xl px-4 py-3 text-right text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-burgundy focus:border-transparent transition" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="email" class="text-sm font-medium text-gray-700">כתובת מייל</label>
          <input type="email" id="email" name="email" placeholder="example@email.com" dir="ltr"
            class="w-full border border-gray-300 rounded-xl px-4 py-3 text-right text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-burgundy focus:border-transparent transition" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="city" class="text-sm font-medium text-gray-700">יישוב</label>
          <input type="text" id="city" name="city" placeholder="שם הישוב"
            class="w-full border border-gray-300 rounded-xl px-4 py-3 text-right text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-burgundy focus:border-transparent transition" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="notes" class="text-sm font-medium text-gray-700">הערות</label>
          <textarea id="notes" name="notes" rows="5" placeholder="ספרי לנו קצת על עצמך..."
            class="w-full border border-gray-300 rounded-xl px-4 py-3 text-right text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-burgundy focus:border-transparent transition resize-none"></textarea>
        </div>
        <div class="pt-2">
          <button type="submit"
            class="w-full sm:w-auto bg-burgundy hover:bg-burgundy-dark text-white text-lg font-bold px-14 py-4 rounded-full transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-burgundy">
            הצטרפות
          </button>
        </div>
      </form>
    -->

  </section>

  <script>
    const form = document.getElementById('register-form') as HTMLFormElement | null;
    const intro = document.getElementById('register-intro');
    const success = document.getElementById('register-success');
    const errorBox = document.getElementById('register-error');
    const submitBtn = document.getElementById('register-submit') as HTMLButtonElement | null;

    if (form && success && errorBox && submitBtn) {
      const endpoint = form.getAttribute('action') || '';
      const idleLabel = submitBtn.textContent ? submitBtn.textContent.trim() : 'הצטרפות';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submitBtn.disabled) return;

        errorBox.hidden = true;
        submitBtn.disabled = true;
        submitBtn.setAttribute('aria-busy', 'true');
        submitBtn.textContent = 'שולחת...';

        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });

          if (response.ok) {
            form.hidden = true;
            if (intro) intro.hidden = true;
            success.hidden = false;
            success.focus();
            success.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
          }
          throw new Error('formspree responded with ' + response.status);
        } catch (error) {
          errorBox.hidden = false;
          submitBtn.disabled = false;
          submitBtn.removeAttribute('aria-busy');
          submitBtn.textContent = idleLabel;
          errorBox.focus();
        }
      });
    }
  </script>

</BaseLayout>
